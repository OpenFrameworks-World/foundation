{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openframeworks.world/schemas/meta.contract.schema.json",
  "title": "OpenFrameworks Meta Contract",
  "description": "Base validation schema for every OpenFrameworks artifact.",
  "type": "object",
  "required": [
    "identity",
    "type",
    "capability",
    "context",
    "governance",
    "lifecycle",
    "publishing",
    "versioning",
    "conformance"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "canonical_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "type": {
      "type": "object",
      "required": ["artifact_type"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "framework",
            "framework-card",
            "framework-blueprint",
            "operating-model",
            "architecture-model",
            "system",
            "value-model",
            "outcome",
            "measurement",
            "evidence",
            "trust-record",
            "risk-record",
            "certification-claim",
            "accreditation-record",
            "adoption-record",
            "feedback-record",
            "foundation-change-proposal",
            "published-artifact"
          ]
        },
        "framework_type": { "type": "string" },
        "category": { "type": "array", "items": { "type": "string" } },
        "domain": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": ["primary_capability", "capability_statement"],
      "properties": {
        "primary_capability": { "type": "string", "minLength": 1 },
        "secondary_capabilities": { "type": "array", "items": { "type": "string" } },
        "capability_statement": { "type": "string", "minLength": 1 },
        "capability_inputs": { "type": "array", "items": { "type": "string" } },
        "capability_outputs": { "type": "array", "items": { "type": "string" } },
        "capability_boundaries": { "type": "array", "items": { "type": "string" } },
        "capability_loss_risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "valid_domains": { "type": "array", "items": { "type": "string" } },
        "valid_organizations": { "type": "array", "items": { "type": "string" } },
        "valid_jurisdictions": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "not_valid_for": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "relationships": {
      "type": "object",
      "additionalProperties": true
    },
    "composition": {
      "type": "object",
      "properties": {
        "composable": { "type": "boolean" },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "composition_contracts": { "type": "array", "items": { "type": "string" } },
        "compatible_with": { "type": "array", "items": { "type": "string" } },
        "conflicts_with": { "type": "array", "items": { "type": "string" } },
        "substitution_candidates": { "type": "array", "items": { "type": "string" } },
        "preserved_capabilities": { "type": "array", "items": { "type": "string" } },
        "added_capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "required": ["owner"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "maintainer": { "type": "string" },
        "reviewer": { "type": "string" },
        "approver": { "type": "string" },
        "risk_owner": { "type": "string" },
        "decision_record": { "type": "string" },
        "separation_of_duties": { "type": "boolean" },
        "review_cadence": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_level": { "type": "string" },
        "source_quality": { "type": "string" },
        "last_verified_at": { "type": "string" },
        "evidence_gaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "trust_risk": {
      "type": "object",
      "properties": {
        "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust_basis": { "type": "string" },
        "inherited_trust": { "type": "array", "items": { "type": "string" } },
        "non_inherited_claims": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "mitigations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["draft", "reviewed", "validated", "published", "adopted", "measured", "improved", "deprecated", "archived"]
        },
        "previous_state": { "type": "string" },
        "next_review_at": { "type": "string" },
        "deprecated_by": { "type": "string" },
        "replacement": { "type": "string" },
        "transition_history": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "publishing": {
      "type": "object",
      "required": ["publishable", "publishing_status"],
      "properties": {
        "publishable": { "type": "boolean" },
        "publishing_status": {
          "type": "string",
          "enum": ["draft", "candidate", "reviewed", "published", "adopted", "deprecated", "archived", "blocked"]
        },
        "published_at": { "type": "string" },
        "published_version": { "type": "string" },
        "release_notes": { "type": "string" },
        "blocking_issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "value": {
      "type": "object",
      "properties": {
        "purpose": { "type": "string" },
        "target_outcomes": { "type": "array", "items": { "type": "string" } },
        "value_hypothesis": { "type": "string" },
        "expected_value": { "type": "string" },
        "measured_value": { "type": "string" },
        "value_status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "feedback": {
      "type": "object",
      "properties": {
        "feedback_refs": { "type": "array", "items": { "type": "string" } },
        "adoption_feedback": { "type": "array", "items": { "type": "string" } },
        "measurement_feedback": { "type": "array", "items": { "type": "string" } },
        "change_requests": { "type": "array", "items": { "type": "string" } },
        "foundation_impact": { "type": "string" }
      },
      "additionalProperties": true
    },
    "versioning": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "previous_version": { "type": "string" },
        "compatibility": { "type": "string", "enum": ["patch", "minor", "major", "unknown"] },
        "migration_guidance": { "type": "string" },
        "changelog": { "type": "string" }
      },
      "additionalProperties": true
    },
    "conformance": {
      "type": "object",
      "required": ["foundation_version", "conformance_status"],
      "properties": {
        "foundation_version": { "type": "string", "minLength": 1 },
        "schemas": { "type": "array", "items": { "type": "string" } },
        "conformance_tests": { "type": "array", "items": { "type": "string" } },
        "conformance_status": { "type": "string", "enum": ["draft", "not-tested", "passed", "failed", "blocked"] },
        "validation_results": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
